# Copy this file to .env. Never upload your .env to GitHub.
APP_PASSWORD=replace-with-a-long-random-password
HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# Gmail: enable 2-Step Verification and create an App Password.
# Use the generated App Password here, NOT your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=
MAIL_FROM=your-address@gmail.com
MAIL_TO=your-address@gmail.com

# Optional durable state path (default: ./data/state.json)
# DATA_FILE=/data/state.json
